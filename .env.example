# Copy to .env and fill in. Never commit .env.

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://crm:crm@localhost:5433/crm

# Hubstaff mode: "mock" uses generated fixture data, "live" calls the Hubstaff API v2.
# If HUBSTAFF_MODE is unset, the app is live when HUBSTAFF_REFRESH_TOKEN is set, mock otherwise.
HUBSTAFF_MODE=mock

# Personal access token from https://developer.hubstaff.com/personal_access_tokens
# (it is a refresh token; scopes: hubstaff:read hubstaff:write tasks:read tasks:write).
# The app exchanges it for access tokens and stores the rotated refresh token in the DB,
# so this value is only read the first time.
HUBSTAFF_REFRESH_TOKEN=
HUBSTAFF_ORG_ID=
# Hubstaff project that CRM tasks are created in (a client can override it).
HUBSTAFF_PROJECT_ID=

# A session left open longer than this is flagged in the UI.
STALE_SESSION_HOURS=4
# A session left open longer than this is auto-closed on sync, at the end of the
# last Hubstaff activity tracked for that task (or at its start if nothing was tracked).
AUTO_CLOSE_SESSION_HOURS=12

# Protects GET /api/sync for schedulers (send header "Authorization: Bearer <secret>").
CRON_SECRET=change-me

# Local helper that drives the Hubstaff desktop timer (npm run helper).
NEXT_PUBLIC_HUBSTAFF_HELPER_URL=http://127.0.0.1:47811

# Time zone used for "by day" totals and displayed times (IANA name). Defaults to the server's.
APP_TIME_ZONE=Europe/Sarajevo

# Local helper (npm run helper). Set HELPER_MOCK=1 to only log CLI calls (no Hubstaff app needed).
HELPER_MOCK=
# HUBSTAFF_CLI_PATH=C:\Program Files\Hubstaff\HubstaffCLI.exe
# HELPER_ALLOWED_ORIGINS=http://localhost:3000
